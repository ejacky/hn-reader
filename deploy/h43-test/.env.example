# Copy to /root/hn-reader-test/.env on h43 and chmod 600. Never commit the real file.
# CI does not manage this file: values here are owned by whoever runs the host.
#
# The staging database is disposable. The LLM key is the production key, but the
# daily budget below is this process's own counter, so staging spend cannot
# exhaust production's allowance.
POSTGRES_PASSWORD=change-me-to-a-long-random-hex

# LLM provider
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4.1-flash

# Cost / abuse guards. The deltas from production are deliberate and explained
# in README.md ("Why these values differ"); everything else mirrors production
# so that staging reproduces production behaviour, which is the point of it.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
LLM_DAILY_BUDGET=500
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=90
# Deliberately equal to the values pending deployment to production: a staging
# run that passes here is evidence for that change.
LLM_MAX_OUTPUT_TOKENS=1500
# "none" removes the empty-content failure mode of reasoning models and cuts
# output cost. Set to "off" to omit the parameter entirely for gateways that
# reject it.
LLM_REASONING_EFFORT=none
# Higher than production's 50 so repeated 15-article preload runs do not stop at
# the quota; set it back to 50 (or 5) and recreate the container to exercise the
# quota_exceeded branch.
FREE_QUOTA_LIMIT=200
MAX_BODY_BYTES=262144

# Rate limits. Signup is relaxed because the site sits behind an IP allowlist.
SIGNUP_RATE_PER_HOUR=20
SIGNUP_RATE_PER_DAY=100
API_RATE_PER_MIN=120
SUMMARIZE_RATE_PER_MIN=20
PRELOAD_RATE_PER_MIN=10
# Preload limits are identical to production on purpose: 15 of 20 pending with a
# 200-item queue is the configuration that exposed the "some articles never
# load" bug, so changing them here would hide it.
PRELOAD_MAX_PER_REQUEST=20
PRELOAD_MAX_PENDING_PER_USER=20
PRELOAD_QUEUE_SIZE=200

# HN canonical lookup (override for tests)
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
