# Copy to .env on h43 and chmod 600. Do not commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-hex

# LLM provider
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4.1-flash

# Cost / abuse guards
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
LLM_DAILY_BUDGET=2000
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=600
FREE_QUOTA_LIMIT=50
MAX_BODY_BYTES=262144

# Rate limits
SIGNUP_RATE_PER_HOUR=5
SIGNUP_RATE_PER_DAY=20
API_RATE_PER_MIN=120
SUMMARIZE_RATE_PER_MIN=20
PRELOAD_RATE_PER_MIN=10
PRELOAD_MAX_PER_REQUEST=20
PRELOAD_MAX_PENDING_PER_USER=20
PRELOAD_QUEUE_SIZE=200

# HN canonical lookup (override for tests)
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
